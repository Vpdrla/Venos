# 가장자리 중에서도 **함정**들 — 백엔드마다 다른 답이 나오기 쉬운 자리.
# edges.my 가 빈 값·별칭·중첩을 맡고, 여기서는 세 언어의 규칙이 서로 다른 곳을 본다:
#   0 으로 나누기, 숫자로 못 바꾸는 문자열, 타입이 섞인 정렬,
#   은행가 반올림(파이썬의 round(2.5) 는 3 이 아니라 2 다), 0.1 + 0.2.
# 생성 퍼저는 늘 도는 프로그램만 만들기 때문에 여기까지 닿지 않는다.
# 에러는 전부 try/catch 로 잡아 고정 문구로 바꿨다 — 그래야 파이썬까지 3중 비교가 된다.

print "=== 0 으로 나누기 ==="
try { print 1 / 0 } catch e { print "잡음1" }
try { print 1 % 0 } catch e { print "잡음2" }
try { print 0 / 0 } catch e { print "잡음3" }

print "=== 숫자 변환 ==="
try { print num("abc") } catch e { print "잡음4" }
print num("  12  "), num("3.5"), num("-0"), num("1e3")
print str(1/3), str(-0.0), str(1000000), str(0.1 + 0.2)

print "=== 타입이 섞인 정렬 ==="
let c = [2, "가", 1]
try { sort(c)  print c } catch e { print "잡음5" }

print "=== 타입을 넘나드는 비교 ==="
print 1 == "1", "1" == 1, [1] == [1.0], "" == 0
print "가" < "나", "A" < "a", "" < "가"
print max(3, 3.0)

print "=== 빈 것에서 꺼내기 ==="
let e1 = []
try { print pop(e1) } catch e { print "잡음6" }
print "가" * 3, "가" * 0
try { print "가" * -1 } catch e { print "잡음7" }

print "=== 반올림 (파이썬의 round 와 다른 자리) ==="
print floor(2.5), floor(-2.5)
print round(2.5), round(-2.5), round(3.5), round(0.5), round(-0.5)
print abs(-0), sqrt(0)

print "=== 깊은 복사가 정말 깊은가 ==="
let d = {"a": [1, {"b": [2]}]}
print d
let d2 = copy(d)
d2["a"][2]["b"][1] = 99
print d, d2
