# 제어 흐름이 어디까지 새는지 보는 케이스.
# break/continue/return 은 try/catch 를 "통과"해야 하고, 중첩 루프에서는 안쪽만 끊어야 한다.

# --- try 안의 break / continue / return ---
func 첫짝수(xs) {
    for x in xs {
        try {
            if x % 2 == 0 { return x }      # try 를 뚫고 함수를 빠져나가야 한다
            if x < 0 { error("음수") }
        } catch 오류 {
            continue                         # catch 안의 continue 도 루프로 가야 한다
        }
    }
    return 0
}
print 첫짝수([1, 3, 4, 5]), 첫짝수([1, 3, 5]), 첫짝수([-1, 7, 8])

func 끊기(xs) {
    let 합 = 0
    for x in xs {
        try {
            if x == 0 { break }              # try 안의 break
            합 += x
        } catch e { print "안 와야 함", e }
    }
    return 합
}
print 끊기([1, 2, 0, 100])

# --- 중첩 루프: 안쪽만 끊긴다 ---
let 흔적 = []
for i = 1 to 3 {
    for j = 1 to 3 {
        if j == 2 { break }
        push(흔적, i * 10 + j)
    }
    push(흔적, i)
}
print 흔적

let 흔적2 = []
for i = 1 to 3 {
    for j = 1 to 3 {
        if j == 2 { continue }
        push(흔적2, i * 10 + j)
    }
}
print 흔적2

# --- while 안의 break/continue ---
let n = 0
let 모음 = []
while 1 {
    n += 1
    if n > 8 { break }
    if n % 2 == 1 { continue }
    push(모음, n)
}
print 모음, n

# --- 루프 안에서 return (while / for / for-in 전부) ---
func w찾기(목표) { let i = 0  while 1 { i += 1  if i == 목표 { return i * 100 } } }
func f찾기(목표) { for i = 1 to 100 { if i == 목표 { return i * 100 } }  return -1 }
func e찾기(목표) { for x in [5, 6, 7] { if x == 목표 { return x * 100 } }  return -1 }
print w찾기(3), f찾기(4), e찾기(6), f찾기(999), e찾기(9)

# --- 깊게 중첩된 return (조건 안의 조건 안의 루프 안) ---
func 깊이(a, b) {
    if a > 0 {
        while 1 {
            for i = 1 to 10 {
                if i * a == b { return i }
            }
            return 0
        }
    }
    return -1
}
print 깊이(3, 12), 깊이(3, 100), 깊이(-1, 5)

# --- 재귀 + return (반환값이 섞이지 않는지) ---
func 합(n) { if n <= 0 { return 0 }  return n + 합(n - 1) }
func 곱(a, b) { if b == 0 { return 0 }  return a + 곱(a, b - 1) }
print 합(10), 곱(3, 4), 합(3) + 곱(2, 3) + 합(4)
func 겹침(n) { return 합(n) + 곱(n, 2) }
print 겹침(4), 겹침(5)

# --- 메서드에서의 return / break ---
class 모음집 {
    func init() { self.값 = [] }
    func 넣기(x) { push(self.값, x)  return self }
    func 찾기(목표) {
        for i = 1 to len(self.값) {
            if self.값[i] == 목표 { return i }
        }
        return 0
    }
    func 합() {
        let s = 0
        for x in self.값 {
            if x == 0 { break }
            s += x
        }
        return s
    }
}
let c = 모음집()
c.넣기(4)  c.넣기(7)  c.넣기(0)  c.넣기(9)
print c.찾기(7), c.찾기(100), c.합()

# --- try 안에서 함수가 에러를 내도 바깥 흐름은 유지 ---
func 위험(x) { if x < 0 { error("음수: {x}") }  return sqrt(x) }
let 결과 = []
for x in [4, -1, 9] {
    try { push(결과, 위험(x)) }
    catch 오류 { push(결과, -1) }
}
print 결과

# --- catch 안에서 return ---
func 안전나눗셈(a, b) {
    try { return a / b }
    catch 오류 { return 0 }
}
print 안전나눗셈(10, 2), 안전나눗셈(10, 0)

# --- 값 없는 return ---
func 아무것도() { return }
func 빈함수() { let x = 1 }
print 아무것도(), 빈함수()

# --- catch 안에서 다시 에러를 내면 바깥 try 가 받는다 ---
# (안쪽 catch 가 끝나기 전에 난 에러라, 같은 try 가 다시 잡으면 무한히 돈다)
try {
    try {
        error("안쪽")
    } catch 안 {
        print "안쪽 잡음:", 안
        error("바깥으로")
    }
    print "!! 여기는 안 나와야 한다"
} catch 밖 {
    print "바깥 잡음:", 밖
}

# --- 함수 안의 함수 (트랜스파일러는 전부 최상위로 끌어올린다) + 재귀 속 try ---
func 겉() {
    func 속(n) {
        if n == 0 { error("바닥") }
        try { return 속(n - 1) } catch 오류 { return "바닥에서 잡음 (" + str(n) + ")" }
    }
    return 속(3)
}
print 겉()
