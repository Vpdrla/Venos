# floor(a / b) 는 파이썬에서 a // b 로 쓴다 — 교과서의 중간값 계산이 그 모양이다.
# 다만 양쪽이 정수로 보일 때만 바꾼다: 파이썬의 // 는 소수끼리면 3.0 같은 소수를 내고,
# 그게 인덱스 자리에 오면 TypeError 다 (math.floor 는 늘 정수를 낸다).
# 세 방식의 출력이 같은지가 이 케이스의 전부다.

let xs = [10, 20, 30, 40, 50, 60, 70]

print "=== 정수끼리 ==="
print floor(len(xs) / 2)
print xs[floor(len(xs) / 2)]
print floor(7 / 2), floor(-7 / 2), floor(0 / 5)

print ""
print "=== 우선순위 (괄호가 빠지면 여기서 어긋난다) ==="
print 2 * floor(len(xs) / 2)
print floor(len(xs) / 2) * 2
print floor(len(xs) / 2) + 1
print 100 - floor(len(xs) / 2)
print floor(floor(len(xs) / 2) / 2)

print ""
print "=== 소수가 섞이면 ==="
print floor(7.5 / 2)
print floor(len(xs) / 2.0)
print floor(sqrt(17) / 2)

print ""
print "=== 반복문 변수도 정수다 ==="
for i = 1 to 7 {
    print i, "->", floor(i / 2)
}

print ""
print "=== 이진탐색의 중간값 ==="
func 이진탐색(A, 찾을값) {
    let 왼쪽 = 1
    let 오른쪽 = len(A)
    while 왼쪽 <= 오른쪽 {
        let 중간 = floor((왼쪽 + 오른쪽) / 2)
        if A[중간] == 찾을값 { return 중간 }
        if A[중간] < 찾을값 { 왼쪽 = 중간 + 1 }
        else { 오른쪽 = 중간 - 1 }
    }
    return 0
}
for 값 in [10, 40, 70, 35] {
    print 값, "->", 이진탐색(xs, 값)
}

print ""
print "=== 인자는 정수인지 알 수 없으므로 math.floor 로 남는다 ==="
func 반토막(n) { return floor(n / 2) }
print 반토막(9), 반토막(-9), 반토막(9.5)
