# 파이썬 변환(topython)이 특히 틀리기 쉬운 자리들을 모아 둔 케이스.
# 에러 문구에 기대지 않는다 — 세 백엔드(인터프리터/C++/파이썬)가 모두 같은 출력을 내야 한다.

# --- 1부터 세는 인덱스: 리터럴과 식 둘 다 ---
let xs = [10, 20, 30, 40, 50]
print xs[1], xs[5]
let i = 2
print xs[i], xs[i + 1], xs[len(xs)]
xs[1] = 11
xs[i] += 5
print xs

# --- 중첩 리스트 ---
let 격자 = [[1, 2, 3], [4, 5, 6]]
격자[2][3] = 60
print 격자[1][2], 격자[2][3]
print 격자

# --- 연산자 우선순위 (괄호를 잘못 붙이면 여기서 깨진다) ---
print 2 + 3 * 4, (2 + 3) * 4
print 10 - 3 - 2, 10 - (3 - 2)
print 100 / 5 / 2, 100 / (5 / 2)
print 7 % 3, -(2 + 3), - 4 + 1
# 나머지는 나누는 수의 부호를 따른다 (수학·파이썬 관례). 시저 암호가 여기에 걸린다
print -7 % 3, 7 % -3, -7 % -3, -1 % 26, 5.5 % 2, -5.5 % 2
print 1 < 2 and 3 > 2, not 0, 1 or 0, not (1 and 0)

# --- 문자열 보간: 식·중첩 괄호·이스케이프 ---
let 이름 = "미르"
let 나이 = 15
print "{이름}은 내년에 {나이 + 1}살"
print "{{중괄호}} 그대로, 값은 {나이}"
print "합: {xs[1] + xs[2]}"

# --- 문자열 + 숫자 자동 이어붙이기 ---
print "나이: " + 나이
print 나이 + 1 + "살"

# --- 문자열 내장 함수 ---
let s = "안녕하세요 반갑습니다"
print len(s), s[1], substr(s, 2, 3)
print find(s, "반갑"), find(s, "없음")
print replace(s, " ", "-")
print upper("abc"), lower("DEF")
print split("a,b,c", ",")
print join(["x", "y", "z"], "-")

# --- 딕셔너리: 정렬 순회 + 키 조회 ---
let 점수 = {"수학": 90, "국어": 80, "영어": 70}
for 과목 in 점수 { print 과목, 점수[과목] }
print keys(점수), has(점수, "수학"), has(점수, "과학")
점수["과학"] = 60
점수["수학"] += 5
print 점수
remove(점수, "국어")
print 점수

# --- for: 방향·step·식으로 준 범위 ---
for a = 1 to 3 { print "a", a }
for b = 3 to 1 { print "b", b }
for c = 1 to 10 step 3 { print "c", c }
for d = 10 to 1 step -4 { print "d", d }
let 끝 = 3
for e = 1 to 끝 { print "e", e }

# --- while + break/continue ---
let n = 0
while n < 10 do {
    n += 1
    if n == 3 { continue }
    if n == 6 { break }
    print "n", n
}

# --- 함수: 재귀, 조기 return, 전역 쓰기 ---
let 카운터 = 0
func 세기() { 카운터 += 1  return 카운터 }
func 팩토리얼(k) {
    if k <= 1 then { return 1 }
    return k * 팩토리얼(k - 1)
}
print 팩토리얼(6), 세기(), 세기(), 카운터

# --- 클래스: 필드, 메서드, 객체 출력, 내용 비교 ---
class 상자 {
    func init(이름, 무게) { self.이름 = 이름  self.무게 = 무게 }
    func 설명() { return "{self.이름}({self.무게}kg)" }
    func 더하기(양) { self.무게 += 양 }
}
let 상자1 = 상자("사과", 3)
let 상자2 = 상자("사과", 3)
print 상자1.설명(), 상자1 == 상자2
상자1.더하기(2)
print 상자1.무게, 상자1 == 상자2
print 상자1

# --- 리스트 연결·깊은 비교·복사 ---
let p = [1, [2, 3]]
let q = copy(p)
q[2][1] = 99
print p, q, p == q, p == [1, [2, 3]]
print [1, 2] + [3], len([1, 2] + [3])

# --- 정렬·push·pop ---
let 정렬 = [3, 1, 2]
sort(정렬)
push(정렬, 9)
print 정렬, pop(정렬), 정렬

# --- 파이썬 예약어/모듈 이름과 겹치는 변수 이름 (Venos 에선 멀쩡한 이름들) ---
let lambda = 1
let import = 2
let def = 3
let math = 4
let sorted = 5
print lambda + import + def + math + sorted
func del(pass) { return pass * 2 }
print del(21)

# --- 내장 함수를 식 안에서 쓰기 (괄호를 안 씌우면 조용히 틀리는 자리들) ---
let 글 = "abcdef"
let 조각 = "abc"
print find(글, "c") * 10                  # (s.find + 1) 을 통째로 묶어야 함
print upper(조각 + "x"), lower("AB" + "CD")
print len(split(조각 + ",d", ","))
print pop([1, 2] + [3])
print replace("x-y" + "-z", "-", "+")
print keys({"b": 1, "a": 2})
print not 0 == 1, (1 and 1) + 5, not (1 or 0)

# --- 소수가 섞인 for (step 을 정수로 깎으면 range(a,b,0) 으로 죽는다) ---
for 반 = 1 to 2 step 0.5 { print "반", 반 }
for 소수 = 1.5 to 3.5 { print "소수", 소수 }

# --- 루프 변수를 안에서 바꾸기 (더 이상 정수가 아니다) ---
for k = 1 to 2 { k = k / 2  print k }

# --- 반올림 계열 (음수 포함) ---
print round(2.5), round(-2.5), floor(2.7), ceil(2.1), abs(-3), min(2, 5), max(2, 5)
print sqrt(16), num("42"), str(7)

# --- 보간 안의 값도 print 와 똑같이 보여야 한다 ---
# (f-string 에 그냥 넣으면 파이썬이 True / {'a': 1} / ['x'] 로 새어 나온다)
let 참 = (3 > 2)
let 거짓 = (1 > 2)
print "비교: {3 > 2}, {1 > 2}", "변수: {참}/{거짓}"
print "부정: {not 0}, 그리고: {1 and 0}, 또는: {0 or 2}"
let 사전 = {"가": 1}
let 목록 = ["x", "y"]
print "사전 {사전} 목록 {목록}"
let 겹 = [[1, "a"], {"b": 2}]
print "겹친 것: {겹}"
class 점 { func init(x) { self.x = x } }
let 한점 = 점(4)
print "객체: {한점}"
print "빈 리스트 {[]} 길이 {len(목록)}"

# --- for 의 방향이 실행할 때 정해지는 경우 (range() 로는 못 내는 자리) ---
let 끝 = 1
for 내림 = 3 to 끝 { print "내림", 내림 }
let 시작 = 3
for 내림2 = 시작 to 1 { print "내림2", 내림2 }
let 영 = 0
for 한칸 = 1 to 영 { print "한칸", 한칸 }
let 같음 = 2
for 제자리 = 2 to 같음 { print "제자리", 제자리 }
# 시작이 소수인데 step 이 정수인 경우 (range 로 내면 파이썬이 TypeError)
let 반쪽 = 1.5
for 소수시작 = 반쪽 to 4 step 1 { print "소수시작", 소수시작 }
# 시작이 확실한 정수면 range 로 나가도 된다
let 목록 = [1, 2, 3]
for 길이부터 = len(목록) to 6 step 2 { print "길이부터", 길이부터 }

# --- 숫자 뒤의 점 ---
# 파이썬에서 `5.뭐()` 는 소수점으로 읽혀 **문법 오류**다. 괄호를 안 씌우면
# 아예 파싱도 안 되는 .py 가 나갔다 — 틀린 답보다 나쁜 건 안 돌아가는 파일이다.
# (Venos·파이썬 둘 다 숫자에 메서드·필드는 에러라, 잡아서 같은 문구로 바꾼다.)
class 점찍기 { func 세기() { return 1 } }
try { print (5).세기() } catch 오류 { print "숫자에 메서드" }
try { print (7).필드 } catch 오류 { print "숫자에 필드" }
try { print (2.5).x } catch 오류 { print "소수에 필드" }
try { print "abc".세기() } catch 오류 { print "문자열에 메서드" }
# 내장 함수도 점을 찍는다 — upper(0) 이 0.upper() 로 나가면 역시 문법 오류다.
# (메서드·필드에서 한 번 고쳤는데 이 경로가 남아 있었다. 생성 퍼저가 찾았다.)
try { print upper(0) } catch 오류 { print "upper 숫자" }
try { print split(5, ",") } catch 오류 { print "split 숫자" }
try { print lower(1.5) } catch 오류 { print "lower 소수" }
try { print keys(7) } catch 오류 { print "keys 숫자" }
# 문장으로 쓴 push/sort/reverse 도 점을 찍는다 — 네 번째 경로였다.
try { push(5, 1) } catch 오류 { print "push 숫자" }
try { sort(7) } catch 오류 { print "sort 숫자" }
try { reverse(2) } catch 오류 { print "reverse 숫자" }

# --- 마지막 원소는 파이썬 관용구로 ---
# xs[len(xs)] 는 Venos 에서 마지막 원소고, 파이썬 사람은 그걸 xs[-1] 이라고 쓴다.
# 뜻이 정확히 같아서(빈 리스트에서 둘 다 에러인 것까지) 여기만 관용구로 낸다.
# 이름이 다르거나(ys[len(xs)]) 대상이 호출이면 손대지 않는다 — 두 번 평가하게 되므로.
let 끝xs = [10, 20, 30]
print 끝xs[len(끝xs)], 끝xs[len(끝xs) - 1]
let 끝s = "가나다"
print 끝s[len(끝s)]
class 끝통 { func init() { self.것 = [1, 2, 3] } }
let 끝t = 끝통()
print 끝t.것[len(끝t.것)]
let 끝빈 = []
try { print 끝빈[len(끝빈)] } catch 오류 { print "빈 리스트: 에러" }
func 끝목록() { return [7, 8, 9] }
print 끝목록()[len(끝목록())]
