# 순회하는 그 자료를 순회 중에 고치는 경우.
# Venos 의 for..in 은 **루프에 들어갈 때의 값**을 돈다. 파이썬의 for 는 살아 있는
# 객체를 돌기 때문에, 그대로 옮기면 push 한 원소까지 돌아 답이 달라진다
# (무한 루프가 되기도 한다). 생성 퍼저가 찾은 자리다.

let xs = [1, 2, 3]
let 횟수 = 0
for x in xs {
    횟수 += 1
    if 횟수 <= 5 { push(xs, x * 10) }
}
print "리스트:", 횟수, len(xs), xs

# 지우면서 도는 경우도 시작 시점 기준이어야 한다
let ys = [1, 2, 3, 4]
let 본것 = []
for y in ys {
    push(본것, y)
    if len(ys) > 1 { remove(ys, 1) }
}
print "지우며:", 본것, ys

# 딕셔너리는 키 정렬 순서로, 역시 시작 시점 기준
let d = {"a": 1, "b": 2}
let n = 0
for k in d {
    n += 1
    if n <= 3 { d[k + "x"] = 9 }
}
print "딕셔너리:", n, keys(d)

# 문자열 순회 중 그 변수를 바꿔도 돌던 문자열은 그대로
let s = "가나다"
let 모은 = ""
for ch in s {
    모은 = 모은 + ch
    s = "바뀜"
}
print "문자열:", 모은, s

# 건드리지 않는 평범한 순회 (여기는 사본을 뜨지 않아야 한다 — 읽기 좋은 파이썬)
let 점수들 = [88, 94, 71]
let 합 = 0
for 점수 in 점수들 { 합 += 점수 }
print "합:", 합
