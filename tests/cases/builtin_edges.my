# 내장 함수를 세 방식으로 나란히 걸어 본 자리들.
# 여기 있는 줄은 대부분 "백엔드마다 다르게 답할 수 있었던" 곳이다 —
# 큰 수 표기, 소수의 나머지, 무엇을 정렬할 수 있는가, pop/remove 가 돌려주는 값,
# 객체의 복사와 비교. 값이 아니라 **세 방식이 같은가**가 이 케이스의 전부다.

print "=== 큰 수 표기 ==="
print 10000000 * 10000000
print 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2
print 1 / 3, 2 / 3, 10 / 4
print 0.1 + 0.2 == 0.3
print 1000000 * 1000000 * 1000000

print ""
print "=== 소수의 나머지 (부호는 나누는 수를 따른다) ==="
print 7.5 % 2, -7.5 % 2, 7 % 2.5

print ""
print "=== 무엇을 정렬할 수 있는가 ==="
# Venos 는 숫자만 또는 문자열만. 파이썬의 sort 는 리스트끼리도 정렬해 버리므로
# 도우미가 같은 검사를 한다 (안 그러면 에러가 조용히 답으로 바뀐다).
print sort([3, 1, 2]), sort(["다", "가", "나"])
try { let 중첩 = sort([[2], [1]])  print 중첩 } catch 오류 { print "중첩 정렬 에러" }
print [1, 2] == [1, 2], [1, [2]] == [1, [2]]

print ""
print "=== pop / remove 가 돌려주는 값 ==="
let xs = [10, 20, 30]
print pop(xs), xs
print remove(xs, 1), xs
let d = {"a": 1, "b": 2}
print remove(d, "a"), d
print remove(d, "없음"), d

print ""
print "=== 객체의 복사와 비교 ==="
class 점 {
    func init(x) { self.x = x }
}
let p = 점(1)
let q = copy(p)
q.x = 9
print p.x, q.x
print p == 점(1), p == q
