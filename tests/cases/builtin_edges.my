# 내장 함수를 세 방식으로 나란히 걸어 본 자리들.
# 여기 있는 줄은 대부분 "백엔드마다 다르게 답할 수 있었던" 곳이다 —
# 큰 수 표기, 소수의 나머지, 무엇을 정렬할 수 있는가, pop/remove 가 돌려주는 값,
# 객체의 복사와 비교. 값이 아니라 **세 방식이 같은가**가 이 케이스의 전부다.

print "=== 큰 수 표기 ==="
print 10000000 * 10000000
print 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2 * 2
print 1 / 3, 2 / 3, 10 / 4
print 0.1 + 0.2 == 0.3
print 1000000 * 1000000 * 1000000

print ""
print "=== 소수의 나머지 (부호는 나누는 수를 따른다) ==="
print 7.5 % 2, -7.5 % 2, 7 % 2.5

print ""
print "=== 무엇을 정렬할 수 있는가 ==="
# Venos 는 숫자만 또는 문자열만. 파이썬의 sort 는 리스트끼리도 정렬해 버리므로
# 도우미가 같은 검사를 한다 (안 그러면 에러가 조용히 답으로 바뀐다).
print sort([3, 1, 2]), sort(["다", "가", "나"])
try { let 중첩 = sort([[2], [1]])  print 중첩 } catch 오류 { print "중첩 정렬 에러" }
print [1, 2] == [1, 2], [1, [2]] == [1, [2]]

print ""
print "=== pop / remove 가 돌려주는 값 ==="
let xs = [10, 20, 30]
print pop(xs), xs
print remove(xs, 1), xs
let d = {"a": 1, "b": 2}
print remove(d, "a"), d
print remove(d, "없음"), d

print ""
print "=== 객체의 복사와 비교 ==="
class 점 {
    func init(x) { self.x = x }
}
let p = 점(1)
let q = copy(p)
q.x = 9
print p.x, q.x
print p == 점(1), p == q

print ""
print "=== 내장 함수에 엉뚱한 타입을 넣으면 ==="
# 파이썬 쪽 기본 동작이 Venos 와 다른 자리들. 전부 "여기서는 에러, 저기서는 답" 이라
# 도우미가 같은 검사를 한다 (생성 퍼저가 join 을 이렇게 찾았다).
try { print join("abc", "-") } catch 오류 { print "join 문자열: 에러" }
try { print join("nan", "") } catch 오류 { print "join 빈구분자: 에러" }
try { print lower([3, 1, 2]) } catch 오류 { print "lower 리스트: 에러" }
try { print len(5) } catch 오류 { print "len 숫자: 에러" }
try { print reverse(5) } catch 오류 { print "reverse 숫자: 에러" }
try { print split([1, 2], ",") } catch 오류 { print "split 리스트: 에러" }
try { print sqrt("abc") } catch 오류 { print "sqrt 문자열: 에러" }
try { print abs("가") } catch 오류 { print "abs 문자열: 에러" }
let 표2 = {"가": 1}
try { print find(표2, "가") } catch 오류 { print "find 딕셔너리: 에러" }
try { print find(표2, "없음") } catch 오류 { print "find 없는키: 에러" }
try { print find(5, 1) } catch 오류 { print "find 숫자: 에러" }

print ""
print "=== 객체가 리스트·딕셔너리·join 안에 들어갔을 때 ==="
# _show 가 객체를 찍는 경로. 중첩 안에서도 세 방식이 같은 글자를 내야 한다.
class 그릇 { func init(v) { self.값 = v  self.것 = [1, "가"] } }
let o = 그릇(3)
print {"k": o}
print join([o], "-")
print join([1, "가", [2], {"a": 1}], "|")
print "보간: {o}"

print ""
print "=== 숫자 자리에 숫자처럼 생긴 문자열 ==="
# 파이썬의 int("2") 는 2 다. 도우미가 그걸 그대로 받으면 Venos 가 거절하는 호출이
# 파이썬에서는 **값을 돌려주고, 대입이면 리스트를 조용히 고친다.**
let 목록2 = [10, 20, 30]
let 둘 = "2"
try { print 목록2[둘] } catch 오류 { print "읽기: 에러" }
try { 목록2[둘] = 99  print 목록2 } catch 오류 { print "쓰기: 에러" }
print 목록2
try { print remove(목록2, 둘) } catch 오류 { print "remove: 에러" }
try { print round(1.567, 둘) } catch 오류 { print "round: 에러" }
try { print random(둘, 둘) } catch 오류 { print "random: 에러" }
try { print substr("abcdef", 둘, 2) } catch 오류 { print "substr 시작: 에러" }
try { print substr([1,2,3], 2, 2) } catch 오류 { print "substr 리스트: 에러" }
# 딕셔너리 키는 문자열이 맞다 — 여기서 막으면 안 된다
let 표3 = {"2": 5}
print 표3[둘]

print ""
print "=== min/max 는 수만 (파이썬은 문자열·리스트도 비교한다) ==="
# 리터럴이면 topython 이 변환 자체를 거절하고, 값이 실행 때 정해지면 도우미가 막는다.
# 생성 퍼저가 min(["b","a"], []) 로 찾은 자리다 — 예전 검사는 문자열 리터럴만 봤다.
let 리스트A = [3, 1]
let 리스트B = [2]
try { print min(리스트A, 리스트B) } catch 오류 { print "min 리스트: 에러" }
try { print max(리스트A, 리스트B) } catch 오류 { print "max 리스트: 에러" }
let 표4 = {"a": 1}
try { print min(표4, 표4) } catch 오류 { print "min 딕셔너리: 에러" }
# 수인 자리는 그대로 돌아야 한다
let 작 = 3
let 큰 = 7.5
print min(작, 큰), max(작, 큰), min(len(리스트A), 1), max(abs(-9), 2)

print ""
print "=== 뒤에서 세는 번호는 없다 ==="
# 글자로 적은 0·-1 은 topython 이 아예 거절한다 (tests/nopython/인덱스_0).
# 여기서는 값이 실행할 때 정해지는 쪽을 본다 — 세 방식이 다 에러여야 한다.
let 셋 = [10, 20, 30]
let 뒤 = 0 - 1
try { print 셋[뒤] } catch 오류 { print "읽기 -1: 에러" }
try { 셋[뒤] = 99  print 셋 } catch 오류 { print "쓰기 -1: 에러" }
let 영번 = 0
try { print 셋[영번] } catch 오류 { print "읽기 0: 에러" }
print "마지막은", 셋[len(셋)], 셋
