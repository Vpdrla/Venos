# random() — 값 자체는 비결정적이라 스위트에 못 넣는다고 오래 비워 뒀던 자리.
# 하지만 **값에서 나오는 성질**은 결정적이다: 범위 안인가, 정수인가, 인자를 거꾸로 줘도
# 같은 범위인가, 세 백엔드가 같은 규칙으로 자르는가. 그건 셋이 갈라질 수 있는 진짜 자리다
# (인터프리터는 mt19937_64, 생성 C++ 는 RUNTIME 의 같은 코드, 파이썬은 random.randint).
# 출력되는 값은 전부 이 성질들뿐이라 3중 비교가 그대로 성립한다.

print "=== 폭이 0 이면 그 값 ==="
print random(5, 5), random(-3, -3), random(0, 0)

print "=== 범위 안인가 ==="
let a = random(1, 10)
print a >= 1 and a <= 10
let 음수 = random(-10, -1)
print 음수 >= -10 and 음수 <= -1

print "=== 거꾸로 줘도 같은 범위 ==="
let b = random(10, 1)
print b >= 1 and b <= 10

print "=== 소수를 주면 정수로 자른다 ==="
let c = random(1.7, 3.2)
print c >= 1 and c <= 3, c == floor(c)

print "=== 숫자가 아니면 에러 ==="
try { print random("가", 3) } catch 오류 { print "잡음" }

print "=== 양끝이 실제로 나오는가 (한쪽으로 쏠리면 여기서 걸린다) ==="
let 표 = [0, 0, 0]
for i = 1 to 300 {
    let k = random(1, 3)
    표[k] = 표[k] + 1
}
print 표[1] + 표[2] + 표[3]
print 표[1] > 0 and 표[2] > 0 and 표[3] > 0
