# num() 과 input 이 "숫자"로 받아들이는 문자열 — 세 언어의 기본 함수가 서로 다른 자리다.
#
# C++ 의 std::stod 는 "0x10"(16), "inf", "nan" 까지 받아 준다.
# 파이썬의 float() 은 그 셋을 거절하는 대신 "1_000" 을 1000 으로 받는다.
# 둘 중 아무거나 그대로 쓰면 같은 프로그램이 백엔드마다 다른 답을 낸다 — 실제로 그랬다.
# 지금은 셋 다 이 문법만 받는다:
#     [공백] [+-] ( 숫자+ [ . 숫자* ] | . 숫자+ ) ( [eE] [+-] 숫자+ )? [공백]

print "=== num() ==="
for s in ["0", "7", "-7", "+5", "3.5", "-0.25", ".5", "5.", "  12  ", "1e3", "2E-2", "0.0"] {
    print "\"" + s + "\" ->", num(s)
}

print ""
print "=== 숫자가 아닌 것들 (세 백엔드가 모두 거절해야 한다) ==="
for s in ["0x10", "inf", "-inf", "nan", "INF", "NaN", "1_000", "1e", "1e999",
          "", " ", "abc", "12abc", "1 2", "--3", "1.2.3", ".", "+", "1,000"] {
    try {
        print "\"" + s + "\" ->", num(s)
        print "   !! 위 줄이 보이면 거절하지 않은 것이다"
    } catch 오류 {
        print "\"" + s + "\" -> 에러"
    }
}

print ""
print "=== 이미 숫자면 그대로 ==="
print num(7), num(-3.5), num(0)

print ""
print "=== input 도 같은 문법으로 본다 ==="
# 숫자로 보이면 숫자로, 아니면 문자열 그대로 들어온다.
# "0x10" 이나 "inf" 를 숫자로 받아 버리면 파이썬 버전이 다른 답을 낸다.
for i = 1 to 6 {
    let 값 = input ""
    # 빼기는 숫자에만 된다 — `값 + 1` 은 문자열이어도 이어붙여지므로 구분이 안 된다
    try {
        print "   숫자:", 값 - 0
    } catch 오류 {
        print "   문자열:", upper(값)
    }
}
