# 문자열 보간 "{식}"
let 이름 = "미르"
let 나이 = 15
print "이름: {이름}, 내년: {나이 + 1}살"
print "{이름}{나이}"                 # 연속 보간은 이어붙이기 (숫자 덧셈 아님)
print "계산: {(3 + 4) * 2}"
let xs = [10, 20]
print "함수 호출: {len(xs)} / {max(xs[1], xs[2])}"
print "리스트: {xs}, 첫 원소: {xs[1]}"
print "진짜 중괄호: {{이름}} 그리고 } 단독"
print "보간 없음 그대로"

class 사람 {
    func init(n) { self.이름 = n }
}
let p = 사람("훈")
print "필드: {p.이름}"

# 보간은 대입/함수 인자 등 문자열이 오는 모든 곳에서 동작
let 메시지 = "안녕 {이름}"
print 메시지
print len("12{34}5")

# 잘못된 보간은 에러 (파스 타임이라 try 로 못 잡음 — 여기선 정상 케이스만)

# --- 파이썬의 서식 문자가 새어 나오지 않는가 ---
# PyGen 의 _show 는 안에서 "%g" % v 와 '"%s": %s' % (...) 를 쓴다.
# 학생 문자열에 %s·%d 가 들어 있어도 그건 그냥 글자여야 한다.
let 표 = {"퍼센트 %s": "값 %d", "백분율": "50%"}
print 표
print "퍼센트 %s %d %% 끝"
print "달러 $x, 중괄호 {{}}, 역슬래시 \\"
let 비율 = 50
print "{비율}% 완료"
print ["%s", "%d", "50%"]
