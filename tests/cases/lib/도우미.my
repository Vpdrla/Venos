# 이 파일은 맨 앞에 BOM 이 들어 있다 — 메모장이 UTF-8 로 저장하면 그렇게 된다.
# 불러오는 쪽에서 중간에 놓이므로, 파일마다 걷어내지 않으면 "보이지 않는 글자" 로 죽는다.
# imports.my 가 불러 쓰는 파일. 러너의 케이스 목록(tests/cases/*.my)에는 안 걸린다.
func 두배(n) {
    return n * 2
}

func 합(xs) {
    let s = 0
    for x in xs { s += x }
    return s
}

class 카운터 {
    func init(시작) { self.값 = 시작 }
    func 올리기() { self.값 += 1  return self.값 }
}
