# 3중 differential 이 빈틈없이 덮고 있는지 보려고 만든 케이스.
# 스위트에 있는 다른 케이스들이 안 건드리던 것들을 모았다 — then/do 채움말,
# 이스케이프, 중첩 경로 대입, 리스트 안의 객체, 나중에 붙인 필드,
# 리터럴 끝 쉼표, 연산자 우선순위, 보간 안의 식.

# --- then / do 채움말 ---
let x = 7
if x > 5 then { print "then 있음" } else { print "없음" }
while x > 5 do { x -= 1 }
print "x =", x

# --- 이스케이프 ---
print "탭:\t끝"
print "따옴표:\"안\""
print "역슬래시:\\"
print "줄바꿈:\n둘째줄"

# --- 문자열 순회 ---
let 모음 = 0
for ch in "안녕하세요" {
    if ch == "하" { 모음 += 1 }
}
print "하 개수:", 모음

# --- 중첩 경로 대입 ---
let d = {"목록": [1, 2, 3], "안": {"깊이": 0}}
d["목록"][2] = 99
d["목록"][3] += 1
d["안"]["깊이"] += 5
print d["목록"], d["안"]["깊이"]

# --- 객체 필드와 메서드 ---
class 상자 {
    func init(값) { self.값 = 값  self.기록 = [] }
    func 넣기(v) { push(self.기록, v)  self.값 += v  return self }
    func 요약() { return self.값 }
}
let b = 상자(10)
b.넣기(5)
b.넣기(7)
b.꼬리표 = "나중에 붙인 필드"
b.값 += 100
print b.요약(), b.기록, b.꼬리표

# --- 리스트 안의 객체 ---
let 상자들 = [상자(1), 상자(2)]
상자들[1].넣기(10)
상자들[2].값 += 3
print 상자들[1].요약(), 상자들[2].요약()

# --- 딕셔너리 순회 중 continue ---
let 합 = 0
for k in d {
    if k == "안" { continue }
    합 += len(k)
}
print "합:", 합

# --- 중첩 함수 호출과 재귀 ---
func 팩(n) {
    if n <= 1 { return 1 }
    return n * 팩(n - 1)
}
func 두번(f) { return f }
print 팩(6), 팩(0)

# --- 리터럴 끝 쉼표, 여러 줄 ---
let 여러줄 = [
    1,
    2,
    3,
]
let 딕여러줄 = {
    "가": 1,
    "나": 2,
}
print 여러줄, keys(딕여러줄)

# --- 문자열 반복과 보간 안의 식 ---
let n = 3
let 별 = "*" * n
print 별, "값: {n * 2}", "이어붙임: {별 + \"!\"}"

# --- 연산자 우선순위 ---
print 2 + 3 * 4, (2 + 3) * 4, 10 - 2 - 3, 2 * 3 % 4
print not (1 == 2) and (3 < 4 or 5 > 9)
print -2 * -3, - -5

# --- 참/거짓 ---
print true, false, true and false, true or false, not true
