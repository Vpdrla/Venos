# 수를 보여 주는 방식과 경계값.
#
# Venos 의 수는 실수 하나라, "정수처럼 보이는가"와 "몇 자리까지 쓰는가"를 toString 이
# 한 규칙으로 정한다: |x| < 9e18 이고 정수면 자릿수를 다 쓰고, 그 위는 %g 다.
# 파이썬 쪽 _show 도 **같은 규칙**이어야 하는데 float 에만 걸려 있었다 —
# _num("1e20") 이 파이썬 정수를 돌려주므로 str(num("1e20")) 이
# 여기서는 1e+20, 저기서는 자릿수 21개였다.
#
# 2^53 을 넘는 **계산**은 일부러 넣지 않았다 (파이썬 정수에는 한계가 없어 더 정확하다).
# 그건 명세에 적힌 차이고, 생성 파일 머리말도 그렇게 말한다.

print "=== 0 과 부호 ==="
print 0, -0, 0.0, 1, -1
print abs(-0), 0 == -0, str(-0.0)

print ""
print "=== 나눗셈 표기 (양쪽을 %g 로 맞춘다) ==="
print 1 / 3, 2 / 3, 1 / 7, 10 / 4, -1 / 3
print 0.1 + 0.2, 0.1 * 3, 1 - 0.9

print ""
print "=== 9e18 위아래 ==="
# 아래는 자릿수를 다 쓰고, 위는 %g 다. 두 방식이 같은 자리에서 갈라져야 한다.
print 1000000000000000, 1000000000000000000
print num("1e18"), num("1e19"), num("1e20")
print str(num("1e20")), str(num("1e15"))

print ""
print "=== 지수 표기는 리터럴로 못 쓴다 (num 으로는 된다) ==="
print num("1e10"), num("1E-3"), num("2.5e8"), num("  1e3  ")

print ""
print "=== 반올림·내림 ==="
print round(2.5), round(-2.5), round(3.5), round(0.5), round(-0.5)
print round(1.005, 2), round(2.675, 2), round(1 / 3, 4)
print floor(-0.5), ceil(-0.5), floor(2.5), ceil(2.5), floor(-2.5), ceil(-2.5)
print sqrt(2), sqrt(0), sqrt(1)

print ""
print "=== 나머지는 나누는 수의 부호를 따른다 ==="
print 7 % 3, -7 % 3, 7 % -3, -7 % -3
print 7.5 % 2, -7.5 % 2, 7 % 2.5

print ""
print "=== 수처럼 생긴 문자열 ==="
print num("007"), num("-0"), num(" 42 "), num("3.")
try { print num("0x10") } catch 오류 { print "0x10: 에러" }
try { print num("1_000") } catch 오류 { print "1_000: 에러" }
try { print num("inf") } catch 오류 { print "inf: 에러" }
try { print num("") } catch 오류 { print "빈 문자열: 에러" }
