# 메모장이 UTF-8 로 저장하면 파일 앞에 BOM(U+FEFF)이 붙는다 — 이 파일에 실제로 들어 있다.
# 소스에서는 건너뛰고, **문자열 안에서는 그대로 남아야** 한다 (그건 자료지 문법이 아니다).
let 점수 = 90
print "BOM 뒤에도 프로그램은 돈다: " + 점수

# 붙여넣기로 섞여 드는 글자들 — 문자열 안에서는 손대지 않는다
let 따옴표 = "“안녕”"
let 공백 = "가 나"
let 전각 = "다　라"
let 줄표 = "마–바"
print 따옴표, len(따옴표)
print 공백, len(공백)
print 전각, len(전각)
print 줄표, len(줄표)
print len(따옴표 + 공백 + 전각 + 줄표)
