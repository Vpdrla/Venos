# 정수로 보이는 변수와 아닌 변수 — PyGen 의 정수 추론이 잘못 짚으면
# 파이썬이 `5.0` 을 찍거나 `//` 가 소수를 내놓아 **출력이 달라진다**.
# 여기 있는 줄은 전부 "한 글자만 어긋나도 3중 비교가 깨지는" 자리다.

print "=== 정수로 보여야 하는 것 ==="
let A = [10, 20, 30, 40, 50]
let n = len(A)
let 절반 = floor(n / 2)
let 합 = 0
for i = 1 to n { 합 = 합 + i }
print "n={n} 절반={절반} 합={합}"
print n, 절반, 합

print ""
print "=== 정수가 아닌 것 (5.0 으로 새면 안 된다) ==="
let 몫 = n / 2
let 평균 = 합 / n
print "몫={몫} 평균={평균}"
print 몫, 평균
# 정수로 시작했다가 소수가 되는 변수 — 한 자리라도 소수면 전부 소수 취급이어야 한다
let 섞임 = 3
섞임 = 섞임 / 2
print 섞임
let 섞임2 = 7
if n > 0 { 섞임2 = 2.5 }
print 섞임2

print ""
print "=== 같은 이름이 범위마다 다른 것 ==="
# 바깥의 k 는 정수, 함수 안의 k 는 소수다. 이름으로만 묶으면 둘 다 막히거나
# (실익 0) 둘 다 정수로 보여 (틀린 출력) — 범위를 키에 넣어야 갈라진다.
let k = 4
func 소수쪽(m) {
    let k = m / 4
    return k
}
func 정수쪽(m) {
    let k = floor(m / 4)
    return k
}
print "바깥 k={k}", 소수쪽(10), 정수쪽(10)
print k

print ""
print "=== 인자는 무엇이든 올 수 있다 ==="
# 인자는 정수라고 단정할 수 없다 — 호출하는 쪽이 소수를 넣을 수 있다.
func 그대로(x) { print "x={x}"  return x }
print 그대로(3), 그대로(3.5)

print ""
print "=== 전역 카운터 (함수 안에서 늘어난다) ==="
let 횟수 = 0
func 세기(깊이) {
    횟수 = 횟수 + 1
    if 깊이 > 0 { 세기(깊이 - 1) }
    return 횟수
}
print 세기(3), "번 불렀다: {횟수}"

print ""
print "=== for 루프 변수에 다시 대입 ==="
let 자취 = ""
for i = 1 to 3 {
    자취 = 자취 + "{i}/"
    i = i + 0.5
    자취 = 자취 + "{i} "
}
print 자취

print ""
print "=== for-in 과 catch 변수는 정수가 아니다 ==="
for v in A { 자취 = "{v}" }
print 자취
try { let 나쁨 = A[99] } catch 오류 { print "잡음" }
