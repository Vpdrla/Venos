# exit() — 내장 함수 중 유일하게 스위트가 한 번도 건드리지 않았던 것.
# (time() 과 random() 은 비결정적이라 못 쓰지만 exit() 은 결정적이다.)
#
# 세 백엔드가 서로 다른 방법으로 구현한다: 인터프리터는 ExitSignal 예외,
# 생성 C++ 는 RUNTIME 의 같은 예외, 파이썬은 sys.exit(0). 그래서 여기가 갈라지기 쉽다.
# 확인하는 것: 루프 한가운데서 끊기는가, 함수 몇 겹 아래에서도 끊기는가,
# **try 를 뚫고 나가는가** (exit 은 에러가 아니므로 catch 에 잡히면 안 된다).

func 깊이(n) {
    print "깊이", n
    if n == 3 {
        print "세 겹 아래에서 끝낸다"
        exit()
    }
    깊이(n + 1)
}

print "시작"
for i = 1 to 5 {
    print "바퀴", i
    if i == 2 { break }
}

try {
    print "try 안으로 들어간다"
    깊이(1)
} catch 오류 {
    print "!! 이 줄이 보이면 exit 이 catch 에 잡힌 것이다:", 오류
}

print "!! 이 줄도 보이면 안 된다"
