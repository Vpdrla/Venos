# 병합 정렬 (merge sort)
#
# 교과서 의사코드:
#   MergeSort(A, 시작, 끝)
#       if 시작 < 끝
#           중간 ← ⌊(시작 + 끝) / 2⌋
#           MergeSort(A, 시작, 중간)
#           MergeSort(A, 중간+1, 끝)
#           Merge(A, 시작, 중간, 끝)
#
#   Merge(A, 시작, 중간, 끝)
#       두 묶음의 앞에서부터 작은 것을 골라 임시 자리에 옮기고, 다 옮기면 되돌린다
#
# 반으로 쪼개서 각각 정렬한 뒤 **합치는** 방식이라, 자료가 어떻게 생겼든 비교 횟수가
# n log n 에서 크게 벗어나지 않는다 (선택·삽입 정렬의 n² 와 다른 점).

func 합치기(A, 시작, 중간, 끝) {
    let 임시 = []
    let i = 시작
    let j = 중간 + 1
    while i <= 중간 and j <= 끝 {
        if A[i] <= A[j] {
            push(임시, A[i])
            i += 1
        } else {
            push(임시, A[j])
            j += 1
        }
    }
    while i <= 중간 { push(임시, A[i])  i += 1 }     # 왼쪽에 남은 것
    while j <= 끝   { push(임시, A[j])  j += 1 }     # 오른쪽에 남은 것
    for k = 1 to len(임시) {
        A[시작 + k - 1] = 임시[k]
    }
}

func 병합정렬(A, 시작, 끝) {
    if 시작 >= 끝 { return A }                       # 원소 0개나 1개는 이미 정렬돼 있다
    let 중간 = floor((시작 + 끝) / 2)
    병합정렬(A, 시작, 중간)
    병합정렬(A, 중간 + 1, 끝)
    합치기(A, 시작, 중간, 끝)
    return A
}

# 교과서는 MergeSort(A, 1, n) 이라고 쓴다. 쓰기 쉽게 감싸 두면 정렬(A) 한 번이면 된다.
func 정렬(A) {
    return 병합정렬(A, 1, len(A))
}

let 자료 = [29, 10, 14, 37, 13, 5, 25]
print "정렬 전:", 자료
정렬(자료)
print "정렬 후:", 자료

# 핵심은 "이미 정렬된 두 묶음을 합치는" 부분이다. 그것만 따로 돌려 본다 —
# 한 리스트 안에 왼쪽 [1,4,7] 과 오른쪽 [2,3,9] 를 나란히 두고 합치면 전체가 정렬된다.
let 둘 = [1, 4, 7, 2, 3, 9]
합치기(둘, 1, 3, 6)
print ""
print "정렬된 두 묶음 합치기: [1,4,7] + [2,3,9] →", 둘

# 비교 횟수 — n log n 이 어떤 모양인지 눈으로 본다
let 비교 = 0
func 세는_합치기(A, 시작, 중간, 끝) {
    let 임시 = []
    let i = 시작
    let j = 중간 + 1
    while i <= 중간 and j <= 끝 {
        비교 += 1
        if A[i] <= A[j] { push(임시, A[i])  i += 1 }
        else            { push(임시, A[j])  j += 1 }
    }
    while i <= 중간 { push(임시, A[i])  i += 1 }
    while j <= 끝   { push(임시, A[j])  j += 1 }
    for k = 1 to len(임시) { A[시작 + k - 1] = 임시[k] }
}
func 세는_정렬(A, 시작, 끝) {
    if 시작 >= 끝 { return A }
    let 중간 = floor((시작 + 끝) / 2)
    세는_정렬(A, 시작, 중간)
    세는_정렬(A, 중간 + 1, 끝)
    세는_합치기(A, 시작, 중간, 끝)
    return A
}
func 비교횟수(A) {
    비교 = 0
    세는_정렬(A, 1, len(A))
    return 비교
}
print ""
print "8개 뒤섞임 → 비교", 비교횟수([5, 3, 8, 1, 7, 2, 6, 4]), "회   (n log n ≈ 24)"
print "8개 정렬됨 → 비교", 비교횟수([1, 2, 3, 4, 5, 6, 7, 8]), "회"
print "8개 거꾸로 → 비교", 비교횟수([8, 7, 6, 5, 4, 3, 2, 1]), "회"

# 경계값 — 원소 0개·1개·2개, 전부 같은 값
print ""
print "빈 리스트:", 정렬([])
print "한 개:", 정렬([7])
print "두 개:", 정렬([2, 1])
print "전부 같음:", 정렬([4, 4, 4])
