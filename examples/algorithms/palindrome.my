# 문자열 뒤집기와 회문(palindrome) 판별
#
# 회문: 거꾸로 읽어도 같은 말. "기러기", "토마토", "다시 합창합시다"

# 1) 직접 뒤집기 — 뒤에서부터 한 글자씩 붙인다 (교과서식)
func 뒤집기(s) {
    let 결과 = ""
    for i = len(s) to 1 step -1 {
        결과 = 결과 + s[i]
    }
    return 결과
}

# 2) 내장 reverse() 로도 된다
print "손으로:", 뒤집기("안녕하세요"), " 내장으로:", reverse("안녕하세요")

# 회문 판별 ① 뒤집어서 비교
func 회문인가(s) { return s == 뒤집기(s) }

# 회문 판별 ② 양 끝에서 좁혀 오기 — 문자열을 새로 만들지 않는다
func 회문인가2(s) {
    let 왼 = 1
    let 오른 = len(s)
    while 왼 < 오른 {
        if s[왼] != s[오른] { return 0 }
        왼 += 1
        오른 -= 1
    }
    return 1
}

print ""
for 말 in ["기러기", "토마토", "사과", "level", "안녕하세요", ""] {
    print "\"{말}\" → {회문인가(말)} / {회문인가2(말)}"
}

# 공백을 무시하는 회문 — "다시 합창합시다"
func 공백빼기(s) { return replace(s, " ", "") }
print ""
for 문장 in ["다시 합창합시다", "여보 안경 안 보여", "오늘은 좋은 날"] {
    let 압축 = 공백빼기(문장)
    print "\"{문장}\" → {회문인가(압축)}"
}

# 단어 단위 뒤집기
func 단어뒤집기(문장) {
    let 낱말 = split(문장, " ")
    reverse(낱말)
    return join(낱말, " ")
}
print ""
print 단어뒤집기("나는 오늘 학교에 간다")

# 가장 긴 회문 부분 문자열 (가운데에서 퍼뜨리기)
func 가장긴회문(s) {
    let 최고 = ""
    for 가운데 = 1 to len(s) {
        for 폭 in [0, 1] {                    # 폭 0 = 홀수 길이, 1 = 짝수 길이
            let 왼 = 가운데
            let 오른 = 가운데 + 폭
            while 왼 >= 1 and 오른 <= len(s) and s[왼] == s[오른] {
                왼 -= 1
                오른 += 1
            }
            let 조각 = substr(s, 왼 + 1, 오른 - 왼 - 1)
            if len(조각) > len(최고) { 최고 = 조각 }
        }
    }
    return 최고
}
print ""
for s in ["babad", "abacabad", "가나다다나라"] {
    print "\"{s}\" 안에서 가장 긴 회문: \"{가장긴회문(s)}\""
}
