# 버블 정렬 (bubble sort)
#
# 교과서 의사코드:
#   for i ← 1 to n-1
#       for j ← 1 to n-i
#           if A[j] > A[j+1] then A[j] 와 A[j+1] 을 교환
#
# 이웃끼리만 비교해서 큰 값이 뒤로 "떠오른다".

func 버블정렬(A) {
    let n = len(A)
    for i = 1 to n - 1 {
        for j = 1 to n - i {
            if A[j] > A[j + 1] {
                let 임시 = A[j]
                A[j] = A[j + 1]
                A[j + 1] = 임시
            }
        }
    }
    return A
}

let 자료 = [5, 1, 4, 2, 8]
print "정렬 전:", 자료
버블정렬(자료)
print "정렬 후:", 자료

# 한 바퀴 도는 동안 한 번도 안 바꿨으면 이미 정렬된 것 — 여기서 멈춘다
func 버블정렬_빠르게(A) {
    let n = len(A)
    for i = 1 to n - 1 {
        let 바꿈 = 0
        for j = 1 to n - i {
            if A[j] > A[j + 1] {
                let 임시 = A[j]
                A[j] = A[j + 1]
                A[j + 1] = 임시
                바꿈 = 1
            }
        }
        print "{i}바퀴 →", A
        if 바꿈 == 0 {
            print "바꾼 게 없으니 끝"
            break
        }
    }
    return A
}
print ""
버블정렬_빠르게([2, 1, 3, 4, 5])
