# 하노이의 탑 — 재귀가 아니면 쓰기 어려운 대표 문제
#
# 교과서 의사코드:
#   하노이(n, 출발, 도착, 경유)
#       if n = 1 then  원반 1 을 출발 → 도착
#       else
#           하노이(n-1, 출발, 경유, 도착)
#           원반 n 을 출발 → 도착
#           하노이(n-1, 경유, 도착, 출발)

let 옮긴횟수 = 0

func 하노이(n, 출발, 도착, 경유) {
    if n == 1 {
        옮긴횟수 += 1
        print "{옮긴횟수}. 원반 1: {출발} → {도착}"
        return 0
    }
    하노이(n - 1, 출발, 경유, 도착)
    옮긴횟수 += 1
    print "{옮긴횟수}. 원반 {n}: {출발} → {도착}"
    하노이(n - 1, 경유, 도착, 출발)
    return 0
}

print "원반 3개:"
하노이(3, "A", "C", "B")
print "총 {옮긴횟수}번"

# 횟수만 세기 — 원반이 하나 늘 때마다 정확히 두 배 + 1 이 된다
func 횟수(n) {
    # 바닥은 n == 1 이 아니라 n <= 0 이어야 한다 — n == 1 만 보면 0 이나 음수를 넣었을 때
    # n 이 바닥을 지나쳐 영원히 내려가고, "재귀 2000회 초과" 로 죽는다.
    # 반복으로 쓴 아래 횟수_반복() 은 0 을 돌려주므로 둘이 어긋나기도 했다.
    if n <= 0 { return 0 }
    return 2 * 횟수(n - 1) + 1
}
print ""
for n = 1 to 10 { print "원반 {n}개 → {횟수(n)}번 (= 2^{n} - 1)" }

# 큰 수는 반복으로 (재귀로는 시간이 오래 걸린다)
func 횟수_반복(n) {
    let 답 = 0
    for i = 1 to n { 답 = 2 * 답 + 1 }
    return 답
}
print ""
print "원반 50개 →", 횟수_반복(50), "번"
print "1초에 한 번씩 옮겨도", round(횟수_반복(50) / 60 / 60 / 24 / 365 / 10000, 1), "만 년"
#
# 전설의 하노이 탑은 원반이 64개다. 2^64 - 1 = 약 1844경으로,
# Venos 가 정확히 셀 수 있는 범위(약 9천조)를 넘는다 — 그래서 여기서는 50개까지만 센다.
# 파이썬은 정수에 한계가 없어서 64개도 정확히 나온다. 숫자가 아주 커지면
# venos topython 으로 옮겨서 돌려 보는 것도 방법이다.

# --- 경계값 ---
# 재귀의 바닥은 "정확히 맞는 값"이 아니라 "지나칠 수 없는 선"이어야 한다.
print ""
print "=== 경계값 ==="
print "횟수(0) =", 횟수(0), " 횟수_반복(0) =", 횟수_반복(0)
print "횟수(-3) =", 횟수(-3), " 횟수_반복(-3) =", 횟수_반복(-3)
print "둘이 같은가:", 횟수(0) == 횟수_반복(0) and 횟수(-3) == 횟수_반복(-3)
