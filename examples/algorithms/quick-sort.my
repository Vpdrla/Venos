# 퀵 정렬 (quicksort — Lomuto 분할)
#
# 교과서 의사코드:
#   QuickSort(A, 낮, 높)
#       if 낮 < 높
#           p ← Partition(A, 낮, 높)
#           QuickSort(A, 낮, p-1)
#           QuickSort(A, p+1, 높)
#
#   Partition(A, 낮, 높)
#       피벗 ← A[높]
#       i ← 낮 - 1
#       for j ← 낮 to 높-1
#           if A[j] ≤ 피벗
#               i ← i + 1;  swap A[i], A[j]
#       swap A[i+1], A[높];  return i+1
#
# 기준값(피벗)보다 작은 것을 앞으로 몰아 두면 피벗은 **제자리**를 찾는다.
# 그 양옆을 같은 방법으로 다시 정렬한다.

func 바꾸기(A, i, j) {
    let t = A[i]
    A[i] = A[j]
    A[j] = t
}

func 나누기(A, 낮, 높) {
    let 피벗 = A[높]
    let i = 낮 - 1
    for j = 낮 to 높 - 1 {          # 높 == 낮 이면 한 번도 안 돈다
        if A[j] <= 피벗 {
            i += 1
            바꾸기(A, i, j)
        }
    }
    바꾸기(A, i + 1, 높)
    return i + 1
}

func 퀵정렬(A, 낮, 높) {
    if 낮 < 높 {
        let p = 나누기(A, 낮, 높)
        퀵정렬(A, 낮, p - 1)
        퀵정렬(A, p + 1, 높)
    }
    return A
}

# 교과서는 QuickSort(A, 1, n) 이라고 쓴다.
func 정렬(A) {
    return 퀵정렬(A, 1, len(A))
}

let 자료 = [29, 10, 14, 37, 13, 5, 25]
print "정렬 전:", 자료
정렬(자료)
print "정렬 후:", 자료

# 분할 한 번을 눈으로 본다 — 피벗(마지막 값)이 제자리로 가고, 왼쪽은 전부 그보다 작다
let 한번 = [7, 2, 9, 4, 5]
let 자리 = 나누기(한번, 1, 5)
print ""
print "피벗 5 로 한 번 나누면:", 한번, "→ 피벗이", 자리, "번 자리"

# 피벗을 마지막 값으로 고르면 **이미 정렬된 자료가 최악**이다 (n² 비교).
# 그래서 실전 구현은 가운데 값이나 무작위를 고른다 — 그 차이를 세어 본다.
let 비교 = 0
func 세는_나누기(A, 낮, 높) {
    let 피벗 = A[높]
    let i = 낮 - 1
    for j = 낮 to 높 - 1 {
        비교 += 1
        if A[j] <= 피벗 {
            i += 1
            바꾸기(A, i, j)
        }
    }
    바꾸기(A, i + 1, 높)
    return i + 1
}
func 세는_정렬(A, 낮, 높) {
    if 낮 < 높 {
        let p = 세는_나누기(A, 낮, 높)
        세는_정렬(A, 낮, p - 1)
        세는_정렬(A, p + 1, 높)
    }
    return A
}
func 비교횟수(A) {
    비교 = 0
    세는_정렬(A, 1, len(A))
    return 비교
}
print ""
print "8개 뒤섞임 → 비교", 비교횟수([5, 3, 8, 1, 7, 2, 6, 4]), "회"
print "8개 정렬됨 → 비교", 비교횟수([1, 2, 3, 4, 5, 6, 7, 8]), "회   (최악: 8×7/2 = 28)"
print "8개 거꾸로 → 비교", 비교횟수([8, 7, 6, 5, 4, 3, 2, 1]), "회"

# 경계값 — 원소 0개·1개·2개, 전부 같은 값
print ""
print "빈 리스트:", 정렬([])
print "한 개:", 정렬([7])
print "두 개:", 정렬([2, 1])
print "전부 같음:", 정렬([4, 4, 4])
