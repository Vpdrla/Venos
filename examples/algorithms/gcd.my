# 최대공약수 — 유클리드 호제법 (Euclidean algorithm)
#
# 교과서 의사코드:
#   while b ≠ 0
#       r ← a mod b
#       a ← b
#       b ← r
#   return a
#
# "큰 수를 작은 수로 나눈 나머지로 바꿔 가면 최대공약수만 남는다"

func 최대공약수(a, b) {
    while b != 0 {
        let 나머지 = a % b
        a = b
        b = 나머지
    }
    return a
}

# 재귀로 쓰면 정의 그대로가 된다: gcd(a, b) = gcd(b, a mod b), gcd(a, 0) = a
func 최대공약수_재귀(a, b) {
    if b == 0 { return a }
    return 최대공약수_재귀(b, a % b)
}

print "gcd(48, 18) =", 최대공약수(48, 18), "/ 재귀:", 최대공약수_재귀(48, 18)
print "gcd(1071, 462) =", 최대공약수(1071, 462)
print "gcd(17, 5) =", 최대공약수(17, 5), "(서로소면 1)"

# 최소공배수 = 두 수의 곱 ÷ 최대공약수
func 최소공배수(a, b) { return a * b / 최대공약수(a, b) }
print ""
print "lcm(4, 6) =", 최소공배수(4, 6)
print "lcm(12, 18) =", 최소공배수(12, 18)

# 과정 보기 — 몇 번 만에 끝나는지가 이 알고리즘의 자랑이다
func 과정(a, b) {
    let 단계 = 0
    while b != 0 {
        단계 += 1
        print "{단계}: {a} = {b} × {floor(a / b)} + {a % b}"
        let 나머지 = a % b
        a = b
        b = 나머지
    }
    print "→ 최대공약수 {a} ({단계}단계)"
    return a
}
print ""
과정(1071, 462)

# 약수를 하나씩 세는 방법과 비교하면 차이가 크다
func 무식하게(a, b) {
    # 0 은 모든 수의 배수라 최대공약수는 나머지 한쪽이다 — 유클리드 쪽과 답을 맞춰 둔다.
    # (안 맞추면 같은 파일의 두 구현이 최대공약수(0, 5) 에 5 와 1 로 갈린다)
    if a == 0 { return b }
    if b == 0 { return a }
    let 답 = 1
    let 작은쪽 = min(a, b)
    for i = 1 to 작은쪽 {
        if a % i == 0 and b % i == 0 { 답 = i }
    }
    return 답
}
print ""
print "무식한 방법 gcd(1071, 462) =", 무식하게(1071, 462), "— 답은 같지만 462번 나눠 본다"

# --- 경계값 ---
# 0 은 모든 수의 배수다. 같은 답을 내야 할 두 구현이 여기서 갈리기 쉽다.
print ""
print "=== 경계값 ==="
print "최대공약수(0,5) =", 최대공약수(0, 5), " 무식하게(0,5) =", 무식하게(0, 5)
print "최대공약수(5,0) =", 최대공약수(5, 0), " 무식하게(5,0) =", 무식하게(5, 0)
print "최대공약수(0,0) =", 최대공약수(0, 0)
print "셋 다 같은가:", 최대공약수(0, 5) == 무식하게(0, 5) and 최대공약수(5, 0) == 무식하게(5, 0)
