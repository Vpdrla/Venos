# 그래프 탐색 — 깊이 우선(DFS)과 너비 우선(BFS)
#
# 교과서 의사코드:
#   DFS(v)
#       방문[v] ← 참
#       v 를 방문 순서에 적는다
#       for each w in 이웃(v)
#           if 방문[w] = 거짓 then DFS(w)
#
#   BFS(시작)
#       큐 ← [시작];  방문[시작] ← 참
#       while 큐가 비어 있지 않은 동안
#           v ← 큐에서 하나 꺼낸다
#           v 를 방문 순서에 적는다
#           for each w in 이웃(v)
#               if 방문[w] = 거짓 then  방문[w] ← 참;  큐에 w 를 넣는다
#
# 그래프는 "이름 → 이웃 목록" 딕셔너리로 적는다 (인접 리스트).
# 방문 표시도 딕셔너리다 — 이름이 문자열이라 그대로 키가 된다.
#
#        가 ── 나 ── 라 ── 마
#        │
#        다 ── 바 ── 사
#
# 깊이 우선은 한 갈래를 끝까지 (가·나·라·마 를 먼저 다 보고 나서 다 쪽으로),
# 너비 우선은 가까운 순서로 (가 다음에 나·다, 그다음 라·바 …) 돈다.
let 그래프 = {
    "가": ["나", "다"],
    "나": ["가", "라"],
    "다": ["가", "바"],
    "라": ["나", "마"],
    "마": ["라"],
    "바": ["다", "사"],
    "사": ["바"],
}

func 새_방문표() {
    let 방문 = {}
    for 점 in 그래프 { 방문[점] = 0 }
    return 방문
}

# ---- 깊이 우선 (재귀) ----
# 한 갈래를 끝까지 따라간 뒤 돌아 나온다. 재귀가 "돌아 나오기"를 대신해 준다.
func 깊이우선(v, 방문, 순서) {
    방문[v] = 1
    push(순서, v)
    for w in 그래프[v] {
        if 방문[w] == 0 {
            깊이우선(w, 방문, 순서)
        }
    }
    return 순서
}

# ---- 너비 우선 (큐) ----
# 가까운 곳부터 한 겹씩 넓혀 간다. 큐는 리스트로 쓰고, 맨 앞에서 꺼낸다.
func 너비우선(시작) {
    let 방문 = 새_방문표()
    let 순서 = []
    let 큐 = [시작]
    방문[시작] = 1
    while len(큐) > 0 {
        let v = remove(큐, 1)          # 맨 앞을 꺼낸다 (큐 = 먼저 들어온 것이 먼저)
        push(순서, v)
        for w in 그래프[v] {
            if 방문[w] == 0 {
                방문[w] = 1            # **넣을 때** 표시해야 같은 점이 두 번 안 들어간다
                push(큐, w)
            }
        }
    }
    return 순서
}

print "깊이 우선(가에서):", 깊이우선("가", 새_방문표(), [])
print "너비 우선(가에서):", 너비우선("가")

# 같은 그래프, 시작점만 바꾸면 순서가 달라진다
print ""
print "사에서 깊이 우선:", 깊이우선("사", 새_방문표(), [])
print "사에서 너비 우선:", 너비우선("사")

# ---- 깊이 우선을 스택으로 (재귀 없이) ----
# 재귀가 쓰는 것이 결국 스택이라는 것을 눈으로 본다. 맨 뒤에서 꺼내면 깊이 우선이다.
# (이웃을 넣는 순서가 뒤집히므로 재귀판과 순서가 다를 수 있다 — 둘 다 올바른 DFS다)
func 깊이우선_스택(시작) {
    let 방문 = 새_방문표()
    let 순서 = []
    let 스택 = [시작]
    while len(스택) > 0 {
        let v = pop(스택)              # 맨 뒤를 꺼낸다 (스택 = 나중에 들어온 것이 먼저)
        if 방문[v] == 0 {
            방문[v] = 1
            push(순서, v)
            for w in 그래프[v] {
                if 방문[w] == 0 { push(스택, w) }
            }
        }
    }
    return 순서
}
print ""
print "스택으로 깊이 우선:", 깊이우선_스택("가")

# ---- 두 점이 이어져 있는지, 몇 걸음인지 ----
# BFS 는 한 겹씩 넓히므로 **처음 닿았을 때가 최단 거리**다 (DFS 는 그렇지 않다).
func 걸음수(시작, 끝) {
    let 거리 = 새_방문표()
    for 점 in 그래프 { 거리[점] = 0 - 1 }
    거리[시작] = 0
    let 큐 = [시작]
    while len(큐) > 0 {
        let v = remove(큐, 1)
        if v == 끝 { return 거리[v] }
        for w in 그래프[v] {
            if 거리[w] == 0 - 1 {
                거리[w] = 거리[v] + 1
                push(큐, w)
            }
        }
    }
    return 0 - 1                       # 못 간다
}
print ""
print "가 → 마:", 걸음수("가", "마"), "걸음"   # 가-나-라-마
print "가 → 가:", 걸음수("가", "가"), "걸음"
print "다 → 사:", 걸음수("다", "사"), "걸음"   # 다-바-사

# 경계값 — 점 하나뿐인 그래프, 이어지지 않은 점
그래프 = {"혼자": []}
print ""
print "점 하나:", 깊이우선("혼자", 새_방문표(), []), 너비우선("혼자"), 걸음수("혼자", "혼자")
그래프 = {"가": ["나"], "나": ["가"], "섬": []}
print "끊긴 그래프:", 너비우선("가"), 걸음수("가", "섬"), "(-1 은 못 간다는 뜻)"
