# 진법 변환 — 10진수 ↔ 2·8·16진수
#
# 교과서 의사코드 (10진 → 2진):
#   while n > 0
#       나머지를 앞에 붙인다
#       n ← n / 2 의 몫

let 숫자표 = "0123456789ABCDEF"

func 진법으로(n, 밑) {
    # 먼저 쓸 수 있는 값인지 본다. 밑이 1 이면 n 이 줄지 않아 **영원히 돈다** —
    # 교과서가 "2 ≤ 밑" 이라고 적어 두는 이유가 이것이다.
    if 밑 < 2 or 밑 > len(숫자표) { error("밑은 2부터 {len(숫자표)} 까지입니다: {밑}") }
    if n < 0 { return "-" + 진법으로(0 - n, 밑) }
    if n == 0 { return "0" }
    let 결과 = ""
    while n > 0 {
        let 자리 = n % 밑
        결과 = 숫자표[자리 + 1] + 결과     # 인덱스는 1부터라 +1
        n = floor(n / 밑)
    }
    return 결과
}

print "10진 → 2진 / 8진 / 16진"
for n in [5, 10, 26, 100, 255] {
    print "{n} → 2진 {진법으로(n, 2)} / 8진 {진법으로(n, 8)} / 16진 {진법으로(n, 16)}"
}

# 되돌리기: 각 자리에 밑의 거듭제곱을 곱해 더한다
func 십진으로(글, 밑) {
    if 밑 < 2 or 밑 > len(숫자표) { error("밑은 2부터 {len(숫자표)} 까지입니다: {밑}") }
    let 값 = 0
    for 글자 in 글 {
        let 자리 = find(숫자표, upper(글자)) - 1
        # 그 진법에 없는 숫자를 그냥 받으면 안 된다 — 2진수의 "9" 는 9 가 아니라 오타다
        if 자리 < 0 or 자리 >= 밑 { error("{밑}진수에 없는 글자입니다: {글자}") }
        값 = 값 * 밑 + 자리
    }
    return 값
}
print ""
for 쌍 in [["11111111", 2], ["377", 8], ["FF", 16], ["1010", 2]] {
    print "{쌍[1]} ({쌍[2]}진) → {십진으로(쌍[1], 쌍[2])}"
}

# 자리 하나하나가 어떻게 나오는지
print ""
print "26 을 2진수로 바꾸는 과정:"
let n = 26
let 자리들 = []
while n > 0 {
    print "{n} ÷ 2 = {floor(n / 2)} ... 나머지 {n % 2}"
    push(자리들, n % 2)
    n = floor(n / 2)
}
reverse(자리들)
print "나머지를 거꾸로 읽으면 →", join(자리들, "")

# --- 경계값 ---
# 교과서는 "2 ≤ 밑" 이라고 적고 넘어가지만, 왜 그런지는 직접 넣어 봐야 안다.
print ""
print "=== 경계값 ==="
print "0 →", 진법으로(0, 2)
print "-26 →", 진법으로(-26, 2), "→ 되돌리기", 십진으로("11010", 2)
try { print 진법으로(7, 1) } catch 오류 { print "밑 1:", 오류 }
try { print 진법으로(7, 99) } catch 오류 { print "밑 99:", 오류 }
try { print 십진으로("9", 2) } catch 오류 { print "2진수의 9:", 오류 }
try { print 십진으로("1A", 10) } catch 오류 { print "10진수의 A:", 오류 }
