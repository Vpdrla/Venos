# 삽입 정렬 (insertion sort)
#
# 교과서 의사코드:
#   for i ← 2 to n
#       key ← A[i]
#       j ← i - 1
#       while j ≥ 1 and A[j] > key
#           A[j+1] ← A[j]
#           j ← j - 1
#       A[j+1] ← key
#
# 앞쪽이 "이미 정렬된 카드 뭉치"이고, 새 카드를 제자리에 끼워 넣는다.

func 삽입정렬(A) {
    let n = len(A)
    for i = 2 to n {
        let 키 = A[i]
        let j = i - 1
        while j >= 1 and A[j] > 키 {
            A[j + 1] = A[j]
            j -= 1
        }
        A[j + 1] = 키
    }
    return A
}

let 자료 = [29, 10, 14, 37, 13]
print "정렬 전:", 자료
삽입정렬(자료)
print "정렬 후:", 자료

# 거의 정렬된 자료에 강하다 — 선택 정렬과 달리 이동 횟수가 자료에 따라 달라진다
func 이동횟수(A) {
    let 이동 = 0
    let n = len(A)
    for i = 2 to n {
        let 키 = A[i]
        let j = i - 1
        while j >= 1 and A[j] > 키 {
            A[j + 1] = A[j]
            j -= 1
            이동 += 1
        }
        A[j + 1] = 키
    }
    return 이동
}
print ""
print "이미 정렬됨  [1,2,3,4,5] → 이동", 이동횟수([1, 2, 3, 4, 5]), "회"
print "거꾸로 정렬  [5,4,3,2,1] → 이동", 이동횟수([5, 4, 3, 2, 1]), "회"
print "뒤섞임      [3,1,5,2,4] → 이동", 이동횟수([3, 1, 5, 2, 4]), "회"
