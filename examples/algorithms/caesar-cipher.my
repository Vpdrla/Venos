# 시저 암호 (Caesar cipher) — 글자를 정해진 칸만큼 밀어 쓰는 가장 오래된 암호
#
# 암호화:  (원래 자리 + 이동) mod 26
# 복호화:  (원래 자리 - 이동) mod 26
#
# 나머지 연산이 음수까지 제대로 돌아야 복호화가 된다.
# Venos 의 % 는 나누는 수의 부호를 따르므로 -1 % 26 = 25 다 (수학·파이썬과 같음).

let 알파벳 = "abcdefghijklmnopqrstuvwxyz"

func 시저(글, 이동) {
    let 결과 = ""
    for 글자 in 글 {
        let 자리 = find(알파벳, lower(글자))
        if 자리 == 0 {
            결과 = 결과 + 글자                              # 알파벳이 아니면 그대로
        } else {
            let 새자리 = (자리 - 1 + 이동) % 26 + 1        # 0부터 세는 자리로 바꿔 계산
            결과 = 결과 + 알파벳[새자리]
        }
    }
    return 결과
}

let 원문 = "hello world"
print "원문:    ", 원문
for 이동 in [1, 3, 13, 25] {
    print "{이동}칸 밀기: {시저(원문, 이동)}"
}

let 암호 = 시저(원문, 3)
print ""
print "암호문:  ", 암호
print "되돌리기:", 시저(암호, -3), "  ← 음수 이동이 그대로 통한다"
print "26칸 밀면 제자리:", 시저(원문, 26)

# ROT13 은 두 번 걸면 원래대로 돌아온다
print ""
let r = 시저(원문, 13)
print "ROT13:", r, "→ 한 번 더:", 시저(r, 13)

# 열쇠를 모를 때 — 25가지를 다 해 보면 하나는 말이 된다 (무차별 대입)
print ""
print "암호문 \"{암호}\" 를 열쇠 없이 풀기:"
for 열쇠 = 1 to 5 {
    print "  열쇠 {열쇠}: {시저(암호, -열쇠)}"
}
print "  ... 열쇠 3 에서 말이 된다"

# 글자 빈도 — 실제로 암호를 깨는 방법
print ""
let 빈도 = {}
let 문장 = "the quick brown fox jumps over the lazy dog the end"
for 글자 in 문장 {
    if find(알파벳, 글자) > 0 {
        if has(빈도, 글자) { 빈도[글자] += 1 }
        else { 빈도[글자] = 1 }
    }
}
let 많은글자 = ""
let 최다 = 0
for 글자 in 빈도 {
    if 빈도[글자] > 최다 { 최다 = 빈도[글자]  많은글자 = 글자 }
}
print "가장 많이 나온 글자: '{많은글자}' ({최다}번) — 영어에서는 보통 e 나 t 다"
