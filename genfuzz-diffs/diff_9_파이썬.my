# genfuzz 가 만든 프로그램 (seed 로 재현)
func 더하기(p, q) { return p + q }
func 두배(p, q) { return (p + q) * 2 }
func 큰쪽(p, q) { if p > q { return p }  return q }
let a = -1
let b = -8
let c = -6
let 수 = 5
let 값 = 2
let s = "x"
let t = "x"
let 글 = "나"
let xs = [0, 3, 6, 9]
let ys = [7, 5]
let 목록 = [4, 7]
let d = {"k1": 6}
let 딕 = {"k1": 1}
for i = 1 to 2 {
    print ys[((abs((a + -2)) % len(ys)) + 1)]
}
for 항목 in xs {
    try {
        print ys[((abs(큰쪽(-7, 16)) % len(ys)) + 1)]
        print xs[((abs(a) % len(xs)) + 1)]
        if min(-17, -9) == ((a % 5) * (-13 * c)) {
            push(xs, join(목록, ""))
        }
    } catch 오류 {
        print "잡음"
    }
    목록[((abs((-3 - c)) % len(목록)) + 1)] = "나"
}
if (max(수, 더하기(-19, 4)) >= min(큰쪽(-4, 수), 17)) or (str(max(-20, -5)) == upper(str(1))) {
    let n = 2
    while n > 0 {
        for e in xs {
            글 = ("x" + upper(str(수)))
            c = b
        }
        n -= 1
    }
} else {
    딕["k1"] = 두배((max(a, -16) % 3), 더하기(min(3, 10), (b * b)))
}
for i = 2 to 1 step 2 {
    t = join(목록, ",")
    목록[((abs(abs(수)) % len(목록)) + 1)] = -12
    if 값 <= abs(-14) { continue }
}
xs[((abs((-11 + a)) % len(xs)) + 1)] = join(목록, "-")
try {
    let n = 2
    while n > 0 {
        print ("" + upper("-"))
        if not ((len(ys) + abs(값)) > 15) { break }
        n -= 1
    }
    if 19 != ((-8 * 10) - a) {
        s = "x"
        try {
            수 = abs(min((c % 5), abs(c)))
            t = str(c)
            print ((4 - max(-5, 수)) % 2)
        } catch 오류 {
            print "잡음"
        }
        for 번 = 1 to 3 step 2 {
            print (len(글) % 5), max(6, max((값 + 5), min(-4, a))), abs(len(글))
            if (-13 * min(-5, c)) != 큰쪽(max(14, a), abs(-12)) { break }
        }
    }
    print 글, (-17 % 5), 값
} catch 오류 {
    print "잡음"
}
for x in d {
    for 항목 in ys {
        push(ys, b)
        d["k2"] = -11
        값 = -19
        if abs(max(값, b)) >= -8 { continue }
    }
    d["k1"] = len(s)
}
push(목록, abs(min(12, max(b, b))))
push(ys, ("가" * (abs(-13) % 4)))
print "--- 끝 ---"
print "a =", a
print "b =", b
print "c =", c
print "수 =", 수
print "값 =", 값
print "s =", s
print "t =", t
print "글 =", 글
print "xs =", xs
print "ys =", ys
print "목록 =", 목록
print "d =", keys(d)
print "딕 =", keys(딕)
