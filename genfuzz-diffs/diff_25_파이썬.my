# genfuzz 가 만든 프로그램 (seed 로 재현)
func 더하기(p, q) { return p + q }
func 두배(p, q) { return (p + q) * 2 }
func 큰쪽(p, q) { if p > q { return p }  return q }
let a = 8
let b = 1
let c = 1
let 수 = -5
let 값 = 1
let s = "abc"
let t = "나"
let 글 = "나"
let xs = [5, 4]
let ys = [0, 9]
let 목록 = [2, 1]
let d = {"k1": 1}
let 딕 = {"k1": 1}
for 항목 in xs {
    push(xs, 더하기(((값 * a) * -16), min(8, 11)))
    let m = 4
    while m > 0 {
        try {
            s = (str(b) * (abs(-2) % 4))
        } catch 오류 {
            print "잡음"
        }
        for 항목 in xs {
            print t, ("나" * (abs(-16) % 4))
        }
        m -= 1
    }
    if len(xs) == -16 { continue }
}
for x in ys {
    let n = 3
    while n > 0 {
        목록[((abs(큰쪽(11, 12)) % len(목록)) + 1)] = "x"
        push(ys, join(목록, "-"))
        n -= 1
    }
    print "한글", max(17, 값)
}
xs[((abs(큰쪽(수, -4)) % len(xs)) + 1)] = len(ys)
d["k2"] = str(수)
d["키"] = "-"
if (8 % 2) != len(글) {
    try {
        push(xs, min(-16, max(-18, abs(a))))
        try {
            push(xs, s)
            수 = ((더하기(2, -20) + c) * (abs(6) % 2))
            print ((len(s) * abs(20)) - (-15 % 5)), "한글", (max(min(값, c), 값) * abs(-5))
        } catch 오류 {
            print "잡음"
        }
        목록[((abs(-12) % len(목록)) + 1)] = 수
    } catch 오류 {
        print "잡음"
    }
    for e in ys {
        딕["k2"] = (값 % 2)
        try {
            push(xs, 두배(19, 17))
        } catch 오류 {
            print "잡음"
        }
        if 큰쪽((-14 * 10), max(값, 5)) >= 수 { break }
    }
    push(목록, (min(abs(c), c) % 2))
}
for i = 2 to 2 {
    try {
        if ((3 % 3) % 2) > max(len(글), (-7 + -17)) {
            print len(xs)
        } else {
            print 8, (str((17 % 7)) + str(10))
            push(목록, abs((11 + abs(3))))
            수 = max(큰쪽(len(목록), 5), len(t))
        }
        s = join(xs, ",")
    } catch 오류 {
        print "잡음"
    }
    push(xs, join(목록, "-"))
    print ys[((abs(max(값, -8)) % len(ys)) + 1)]
    if 15 <= (4 * (2 % 3)) { continue }
}
목록[((abs(abs(c)) % len(목록)) + 1)] = -3
목록[((abs(c) % len(목록)) + 1)] = min(max(-7, -3), abs(5))
print (((글 + "") * (abs(13) % 4)) + "한글"), "", len(글)
print "--- 끝 ---"
print "a =", a
print "b =", b
print "c =", c
print "수 =", 수
print "값 =", 값
print "s =", s
print "t =", t
print "글 =", 글
print "xs =", xs
print "ys =", ys
print "목록 =", 목록
print "d =", keys(d)
print "딕 =", keys(딕)
