{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Venos",
  "scopeName": "source.venos",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#self" },
    { "include": "#builtin" },
    { "include": "#definition" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.venos",
      "match": "#.*$"
    },
    "string": {
      "name": "string.quoted.double.venos",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.venos",
          "match": "\\\\[nt\"\\\\]|\\{\\{|\\}\\}"
        },
        {
          "name": "meta.embedded.interpolation.venos",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.venos" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.venos" } },
          "patterns": [
            { "include": "#number" },
            { "include": "#constant" },
            { "include": "#self" },
            { "include": "#builtin" },
            { "include": "#operator" }
          ]
        }
      ]
    },
    "number": {
      "name": "constant.numeric.venos",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.venos",
          "match": "\\b(if|else|while|for|to|step|in|break|continue|return|try|catch|then|do)\\b"
        },
        {
          "name": "keyword.other.venos",
          "match": "\\b(let|func|class|print|input|import)\\b"
        },
        {
          "name": "keyword.operator.logical.venos",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "constant": {
      "name": "constant.language.venos",
      "match": "\\b(true|false)\\b"
    },
    "self": {
      "name": "variable.language.self.venos",
      "match": "\\bself\\b"
    },
    "builtin": {
      "name": "support.function.builtin.venos",
      "match": "\\b(random|round|floor|ceil|abs|sqrt|min|max|num|str|len|push|pop|sort|reverse|remove|keys|has|split|join|upper|lower|find|replace|substr|readfile|writefile|appendfile|exists|time|exit|copy|error)(?=\\s*\\()"
    },
    "definition": {
      "patterns": [
        {
          "match": "\\b(func)\\s+([^\\s(){}\\[\\]\"#,]+)",
          "captures": {
            "1": { "name": "keyword.other.venos" },
            "2": { "name": "entity.name.function.venos" }
          }
        },
        {
          "match": "\\b(class)\\s+([^\\s(){}\\[\\]\"#,]+)",
          "captures": {
            "1": { "name": "keyword.other.venos" },
            "2": { "name": "entity.name.type.class.venos" }
          }
        }
      ]
    },
    "operator": {
      "name": "keyword.operator.venos",
      "match": "\\+=|-=|\\*=|/=|==|!=|<=|>=|[+\\-*/%<>=]"
    }
  }
}
