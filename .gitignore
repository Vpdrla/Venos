# 컴파일 산출물
*.exe
*.o
*.obj
venos
!venos.cpp

# build 명령이 생성하는 파일 (examples 폴더의 .my → .cpp/실행파일)
examples/*.cpp
examples/*.py
examples/rpg
examples/rpg.en
examples/algorithms/*
!examples/algorithms/*.my
!examples/algorithms/*.md

# 테스트 산출물 (러너가 지우지만 중단 대비)
tests/cases/*
!tests/cases/*.my
!tests/cases/*.input
tests/nopython/*.py
tests/.tmp_*

# 게임 세이브 / 로그
save.txt
*.log

# 퍼저가 죽인 입력을 남기는 곳 (tools/sanitize.sh)
fuzz-crashes/

# CI 가 playground-check 를 돌리려고 설치하는 것
node_modules/
package-lock.json

# IDE
*.cbp
*.layout
*.depend
bin/
obj/
.vscode/
